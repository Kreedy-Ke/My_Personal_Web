---
import { SITE_NAME } from "../config";

interface Props {
    title?: string;
    description: string;
    width?: string;
    backHref?: string;
    backLabel?: string;
}

const {
    title,
    description,
    width = "1280px",
    backHref,
    backLabel = "返回",
} = Astro.props;

const pageTitle = title ? `${title} | ${SITE_NAME}` : SITE_NAME;
const currentPath = Astro.url.pathname;
const navItems = [
    {
        label: "Home",
        href: "/",
        active: currentPath === "/",
    },
    {
        label: "Articles",
        href: "/articles/",
        active: currentPath.startsWith("/articles"),
    },
    {
        label: "Gallery",
        href: "/gallery/",
        active: currentPath.startsWith("/gallery"),
    },
    {
        label: "Reviews",
        href: "/reviews/",
        active: currentPath.startsWith("/reviews"),
    },
];
---

<!doctype html>
<html lang="zh-CN">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width" />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <link rel="icon" href="/favicon.ico" />
        <meta name="generator" content={Astro.generator} />
        <meta name="description" content={description} />
        <title>{pageTitle}</title>
    </head>
    <body>
        <header class="site-header">
            <div class="site-header-inner">
                <a class="site-brand" href="/" aria-label="Kreedy Wiki 首页">
                    <img
                        class="brand-avatar"
                        src="/images/头像.png"
                        alt=""
                        width="38"
                        height="38"
                    />
                    <span class="site-brand-name">Kreedy Wiki</span>
                </a>
                <nav class="site-nav" aria-label="主导航">
                    {navItems.map((item) => (
                        <a
                            href={item.href}
                            aria-current={item.active ? "page" : undefined}
                        >
                            {item.label}
                        </a>
                    ))}
                </nav>
            </div>
        </header>

        <main
            class="site-shell"
            style={`--content-width: ${width}`}
        >
            <div class="side-backdrop side-backdrop--left" aria-hidden="true"></div>
            <div class="side-backdrop side-backdrop--right" aria-hidden="true"></div>

            <div class="page-stage">
                <div class="content-panel">
                    <div class="content-frame">
                        {backHref && <a class="back-link" href={backHref}>{backLabel}</a>}
                        <slot />
                    </div>
                </div>
            </div>
        </main>
    </body>
</html>

<style>
    :global(*) {
        box-sizing: border-box;
    }

    :global(html) {
        --site-header-height: 68px;
        --accent-blue: #4683d1;
        --accent-gradient: linear-gradient(90deg, #ef946d 0%, #7fb5df 52%, #4683d1 100%);

        min-width: 320px;
        background: #f6f2ea;
    }

    :global(body) {
        margin: 0;
        min-height: 100vh;
        font-family:
            Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont,
            "Segoe UI", sans-serif;
        color: #1f2933;
    }

    .site-shell {
        width: 100%;
        margin: 0 auto;
        padding: 0;
    }

    .side-backdrop {
        position: fixed;
        z-index: 0;
        top: var(--site-header-height);
        bottom: 0;
        width: 17.5%;
        overflow: hidden;
        background: #242044;
        pointer-events: none;
    }

    .side-backdrop::before {
        content: "";
        position: absolute;
        inset: -6% 0;
        background-image: url("/images/side-picture.png");
        background-size: cover;
        background-repeat: no-repeat;
        background-position: var(--image-position) center;
        transform: translateX(var(--image-shift));
        image-rendering: pixelated;
    }

    .side-backdrop--left {
        left: 0;
        --image-position: 30%;
        --image-shift: -3%;
    }

    .side-backdrop--right {
        right: 0;
        --image-position: 70%;
        --image-shift: 3%;
    }

    .page-stage {
        position: relative;
        z-index: 1;
        width: 65vw;
        margin: 0 auto;
    }

    .content-panel {
        position: relative;
        z-index: 2;
        min-height: 100vh;
        padding: 48px 40px 72px;
        background: #f6f2ea;
        box-shadow: 0 22px 64px rgb(31 41 51 / 18%);
    }

    .content-panel::before,
    .content-panel::after {
        position: absolute;
        z-index: -1;
        top: 0;
        bottom: 0;
        width: 120px;
        content: "";
        pointer-events: none;
    }

    .content-panel::before {
        right: 100%;
        background: linear-gradient(to left, #f6f2ea 0%, rgb(246 242 234 / 92%) 25%, rgb(246 242 234 / 52%) 62%, transparent 100%);
    }

    .content-panel::after {
        left: 100%;
        background: linear-gradient(to right, #f6f2ea 0%, rgb(246 242 234 / 92%) 25%, rgb(246 242 234 / 52%) 62%, transparent 100%);
    }

    .content-frame {
        width: min(100%, var(--content-width));
        margin: 0 auto;
    }

    .site-header {
        position: sticky;
        z-index: 50;
        top: 0;
        width: 100%;
        height: var(--site-header-height);
        padding: 0 clamp(24px, 4vw, 64px);
        border-bottom: 1px solid #ded6c8;
        background: #f6f2ea;
        box-shadow: 0 8px 24px rgb(31 41 51 / 5%);
    }

    .site-header::after {
        position: absolute;
        right: 0;
        bottom: -1px;
        left: 0;
        height: 2px;
        background: var(--accent-blue);
        content: "";
    }

    .site-header-inner {
        position: relative;
        display: flex;
        width: 100%;
        height: 100%;
        align-items: center;
        justify-content: space-between;
        gap: 24px;
    }

    .site-brand {
        display: inline-flex;
        min-width: max-content;
        align-items: center;
        gap: 12px;
        color: #1f2933;
        text-decoration: none;
    }

    .brand-avatar {
        display: block;
        width: 38px;
        height: 38px;
        flex: 0 0 auto;
        border: 2px solid #f6f2ea;
        border-radius: 5px;
        object-fit: cover;
        background: #fffaf1;
        box-shadow:
            0 0 0 2px #73a6c8,
            inset 0 0 0 2px rgb(255 255 255 / 12%);
    }

    .site-brand-name {
        font-size: 21px;
        font-weight: 650;
        letter-spacing: -0.035em;
    }

    .site-nav {
        position: absolute;
        top: 50%;
        left: 50%;
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        justify-content: center;
        transform: translate(-50%, -50%);
        gap: 4px;
    }

    .site-nav a {
        display: inline-flex;
        min-height: 34px;
        align-items: center;
        justify-content: center;
        padding: 0 13px;
        border: 1px solid transparent;
        border-radius: 999px;
        font-size: 13px;
        color: #4b5563;
        text-decoration: none;
        transition:
            border-color 160ms ease,
            color 160ms ease,
            background 160ms ease;
    }

    .site-nav a:hover {
        border-color: var(--accent-blue);
        color: #1f2933;
        background: transparent;
    }

    .site-nav a[aria-current="page"] {
        border-color: transparent;
        color: #fffaf1;
        background: var(--accent-blue);
        font-weight: 650;
    }

    .back-link {
        display: inline-block;
        margin-bottom: 40px;
        color: #4b5563;
        text-decoration: none;
    }

    .back-link:hover {
        color: #1f2933;
        text-decoration: underline;
        text-decoration-color: var(--accent-blue);
        text-underline-offset: 4px;
    }

    :global(.eyebrow) {
        margin: 0 0 12px;
        font-size: 14px;
        text-transform: uppercase;
        color: #6b7280;
    }

    :global(a:focus-visible) {
        outline: 2px solid #1f2933;
        outline-offset: 4px;
    }

    @media (max-width: 760px) {
        :global(html) {
            --site-header-height: 112px;
        }

        .site-header {
            padding: 0 20px;
        }

        .site-header-inner {
            display: flex;
            align-items: center;
            flex-direction: column;
            justify-content: center;
            gap: 10px;
        }

        .site-nav {
            position: static;
            justify-content: center;
            transform: none;
        }
    }

    @media (max-width: 560px) {
        .content-panel {
            padding: 36px 24px 40px;
        }
    }
</style>
