---
import { getCollection } from "astro:content";
import Layout from "../layouts/Layout.astro";
import { getArticleMeta } from "../lib/articles";

const articles = (await getCollection("articles", ({ data }) => {
    return data.draft !== true;
}))
    .map((article) => ({
        article,
        meta: getArticleMeta(article),
    }))
    .sort((a, b) => b.meta.writtenAt.valueOf() - a.meta.writtenAt.valueOf());

const years = [...new Set(articles.map(({ meta }) => meta.writtenAt.getFullYear()))];
const tags = [
    ...new Set(articles.flatMap(({ meta }) => meta.tags)),
].sort((a, b) => a.localeCompare(b, "zh-CN"));
---

<Layout
    title="Articles"
    description="文章和笔记列表。"
    width="860px"
>
    <header class="list-header">
        <p class="eyebrow">Articles</p>
        <div class="title-row">
            <h1>文章</h1>
            <span class="title-divider" aria-hidden="true"></span>
            <p class="intro">文章、笔记、长文和一些持续整理的想法。</p>
        </div>
    </header>

    <details class="archive-panel" data-archive-panel>
        <summary class="archive-toggle">
            <span class="archive-title-line">
                <span
                    id="archive-title"
                    class="archive-title"
                    role="heading"
                    aria-level="2"
                >
                    归档检索
                </span>
                <span class="archive-title-en" lang="en">Archive</span>
            </span>
            <span class="archive-meta-line">
                <span class="result-count" data-result-count aria-live="polite">
                    {articles.length} 篇文章
                </span>
                <span class="archive-chevron" aria-hidden="true"></span>
            </span>
        </summary>

        <div class="archive-content">
            <label class="archive-search">
                <span>搜索</span>
                <input
                    type="search"
                    placeholder="标题、摘要、标签或年份"
                    autocomplete="off"
                    data-archive-search
                />
            </label>

            <div class="filter-lines">
                <fieldset>
                    <legend>年份</legend>
                    <div class="filter-options">
                        <button
                            type="button"
                            data-filter-year="all"
                            aria-pressed="true"
                        >
                            全部
                        </button>
                        {years.map((year) => (
                            <button
                                type="button"
                                data-filter-year={String(year)}
                                aria-pressed="false"
                            >
                                {year}
                            </button>
                        ))}
                    </div>
                </fieldset>

                {tags.length > 0 && (
                    <fieldset>
                        <legend>标签</legend>
                        <div class="filter-options">
                            <button
                                type="button"
                                data-filter-tag="all"
                                aria-pressed="true"
                            >
                                全部
                            </button>
                            {tags.map((tag) => (
                                <button
                                    type="button"
                                    data-filter-tag={tag}
                                    aria-pressed="false"
                                >
                                    {tag}
                                </button>
                            ))}
                        </div>
                    </fieldset>
                )}
            </div>

            <div class="archive-actions">
                <button class="reset-button" type="button" data-clear-filter hidden>
                    清除筛选
                </button>
            </div>
        </div>
    </details>

    <div class="year-list">
        {years.map((year) => (
            <section class="year-group" data-year={String(year)}>
                <h2 class="year-title">{year}</h2>
                <div class="article-list">
                    {articles
                        .filter(({ meta }) => meta.writtenAt.getFullYear() === year)
                        .map(({ article, meta }) => (
                            <a
                                class="article-card"
                                href={`/articles/${article.id}/`}
                                data-year={String(year)}
                                data-tags={meta.tags.join("|")}
                                data-search={[
                                    meta.title,
                                    meta.summary,
                                    String(year),
                                    ...meta.tags,
                                ].join(" ")}
                            >
                                <h3>{meta.title}</h3>
                                <time datetime={meta.writtenAt.toISOString()}>
                                    {article.data.writtenDate && "写于 "}
                                    {meta.writtenAt.toLocaleDateString("zh-CN", {
                                        month: "2-digit",
                                        day: "2-digit",
                                    })}
                                </time>
                                <p>{meta.summary}</p>
                                {meta.tags.length > 0 && (
                                    <ul class="article-tags" aria-label="文章标签">
                                        {meta.tags.map((tag) => (
                                            <li>{tag}</li>
                                        ))}
                                    </ul>
                                )}
                            </a>
                        ))}
                </div>
            </section>
        ))}
    </div>

    <p class="empty-results" data-empty-results hidden>
        没有找到匹配的文章，请尝试其他关键词或筛选条件。
    </p>
</Layout>

<script>
    (() => {
        const searchInput = document.querySelector<HTMLInputElement>(
            "[data-archive-search]",
        );
        const archivePanel = document.querySelector<HTMLDetailsElement>(
            "[data-archive-panel]",
        );
        const cards = [
            ...document.querySelectorAll<HTMLElement>(".article-card"),
        ];
        const yearGroups = [
            ...document.querySelectorAll<HTMLElement>(".year-group"),
        ];
        const yearButtons = [
            ...document.querySelectorAll<HTMLButtonElement>(
                "[data-filter-year]",
            ),
        ];
        const tagButtons = [
            ...document.querySelectorAll<HTMLButtonElement>(
                "[data-filter-tag]",
            ),
        ];
        const resultCount = document.querySelector<HTMLElement>(
            "[data-result-count]",
        );
        const clearButton = document.querySelector<HTMLButtonElement>(
            "[data-clear-filter]",
        );
        const emptyResults = document.querySelector<HTMLElement>(
            "[data-empty-results]",
        );

        if (
            !searchInput ||
            !resultCount ||
            !clearButton ||
            !emptyResults
        ) {
            return;
        }

        const params = new URLSearchParams(window.location.search);
        const validYears = new Set(
            yearButtons.map((button) => button.dataset.filterYear),
        );
        const validTags = new Set(
            tagButtons.map((button) => button.dataset.filterTag),
        );
        const requestedYear = params.get("year") ?? "all";
        const requestedTag = params.get("tag") ?? "all";

        let selectedYear = validYears.has(requestedYear)
            ? requestedYear
            : "all";
        let selectedTag = validTags.has(requestedTag)
            ? requestedTag
            : "all";

        searchInput.value = params.get("q") ?? "";

        if (
            searchInput.value.trim() ||
            selectedYear !== "all" ||
            selectedTag !== "all"
        ) {
            archivePanel?.setAttribute("open", "");
        }

        const normalize = (value: string) => value.trim().toLocaleLowerCase("zh-CN");

        const updateButtonStates = () => {
            for (const button of yearButtons) {
                button.setAttribute(
                    "aria-pressed",
                    String(button.dataset.filterYear === selectedYear),
                );
            }

            for (const button of tagButtons) {
                button.setAttribute(
                    "aria-pressed",
                    String(button.dataset.filterTag === selectedTag),
                );
            }
        };

        const updateUrl = (query: string) => {
            const nextParams = new URLSearchParams();

            if (query) {
                nextParams.set("q", query);
            }

            if (selectedYear !== "all") {
                nextParams.set("year", selectedYear);
            }

            if (selectedTag !== "all") {
                nextParams.set("tag", selectedTag);
            }

            const search = nextParams.toString();
            const nextUrl = `${window.location.pathname}${search ? `?${search}` : ""}${window.location.hash}`;
            window.history.replaceState(null, "", nextUrl);
        };

        const applyFilters = (syncUrl = true) => {
            const query = normalize(searchInput.value);
            let visibleCount = 0;

            for (const card of cards) {
                const matchesYear =
                    selectedYear === "all" ||
                    card.dataset.year === selectedYear;
                const matchesTag =
                    selectedTag === "all" ||
                    card.dataset.tags?.split("|").includes(selectedTag);
                const matchesQuery =
                    !query ||
                    normalize(card.dataset.search ?? "").includes(query);
                const visible = matchesYear && matchesTag && matchesQuery;

                card.hidden = !visible;

                if (visible) {
                    visibleCount += 1;
                }
            }

            for (const group of yearGroups) {
                group.hidden = !group.querySelector(".article-card:not([hidden])");
            }

            const hasFilters =
                Boolean(query) ||
                selectedYear !== "all" ||
                selectedTag !== "all";

            resultCount.textContent =
                visibleCount > 0 ? `${visibleCount} 篇文章` : "暂无匹配";
            clearButton.hidden = !hasFilters;
            emptyResults.hidden = visibleCount > 0;

            updateButtonStates();

            if (syncUrl) {
                updateUrl(query);
            }
        };

        for (const button of yearButtons) {
            button.addEventListener("click", () => {
                selectedYear = button.dataset.filterYear ?? "all";
                applyFilters();
            });
        }

        for (const button of tagButtons) {
            button.addEventListener("click", () => {
                selectedTag = button.dataset.filterTag ?? "all";
                applyFilters();
            });
        }

        searchInput.addEventListener("input", () => applyFilters());

        clearButton.addEventListener("click", () => {
            searchInput.value = "";
            selectedYear = "all";
            selectedTag = "all";
            applyFilters();
            searchInput.focus();
        });

        applyFilters(false);
    })();
</script>

<style>
    .list-header {
        margin-bottom: 40px;
    }

    .list-header .eyebrow {
        margin-bottom: 4px;
    }

    .title-row {
        display: flex;
        align-items: flex-end;
        gap: 20px;
    }

    .title-divider {
        width: 1px;
        height: 46px;
        flex: 0 0 auto;
        background: var(--border-strong);
    }

    h1 {
        margin: 0;
        font-size: clamp(40px, 7vw, 72px);
        line-height: 1;
    }

    .intro {
        margin: 0;
        font-size: 20px;
        line-height: 1.7;
        color: var(--text-secondary);
    }

    .year-list {
        display: grid;
        gap: 40px;
    }

    .year-title {
        margin: 0 0 16px;
        font-size: 28px;
    }

    .article-list {
        display: grid;
        gap: 16px;
    }

    .article-card {
        position: relative;
        display: block;
        padding: 22px 100px 22px 22px;
        border: 1px solid var(--border);
        border-radius: 8px;
        color: inherit;
        text-decoration: none;
        background: var(--surface);
    }

    .article-card:hover {
        border-color: var(--accent-blue);
        background: var(--surface);
    }

    .article-card h3 {
        margin: 0;
        font-size: 24px;
    }

    .article-card p {
        margin: 14px 0 0;
        color: var(--text-secondary);
        line-height: 1.7;
    }

    .article-tags {
        display: flex;
        flex-wrap: wrap;
        gap: 6px;
        margin: 12px 0 0;
        padding: 0;
        list-style: none;
    }

    .article-tags li {
        padding: 2px 8px;
        border: 1px solid color-mix(in srgb, var(--accent-blue) 38%, transparent);
        border-radius: 999px;
        font-size: 11px;
        line-height: 1.6;
        color: var(--text-muted);
        background: var(--accent-soft);
    }

    .archive-panel {
        margin-bottom: 40px;
        overflow: hidden;
        border: 1px solid var(--border);
        border-radius: 10px;
        background: var(--surface);
        box-shadow: 0 10px 28px var(--panel-shadow);
    }

    .archive-toggle {
        display: block;
        padding: 14px 18px 13px;
        list-style: none;
        cursor: pointer;
    }

    .archive-toggle::-webkit-details-marker {
        display: none;
    }

    .archive-toggle:focus-visible {
        outline: 2px solid var(--accent-blue);
        outline-offset: -4px;
    }

    .archive-title-line {
        display: flex;
        align-items: flex-end;
        gap: 10px;
    }

    .archive-title {
        font-size: 21px;
        font-weight: 700;
        line-height: 1;
    }

    .archive-title-en {
        padding-bottom: 1px;
        font-size: 10px;
        font-weight: 600;
        line-height: 1.2;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        color: var(--text-muted);
    }

    .archive-meta-line {
        display: flex;
        min-height: 17px;
        align-items: center;
        justify-content: space-between;
        gap: 16px;
        margin-top: 3px;
    }

    .archive-chevron {
        width: 0;
        height: 0;
        border-top: 6px solid var(--text-secondary);
        border-right: 5px solid transparent;
        border-left: 5px solid transparent;
        transition: transform 160ms ease;
    }

    .archive-panel[open] .archive-chevron {
        transform: rotate(180deg);
    }

    .archive-content {
        padding: 2px 18px 18px;
    }

    .archive-actions {
        display: flex;
        justify-content: flex-end;
        margin-top: 12px;
    }

    .result-count {
        margin: 0;
        font-size: 13px;
        color: var(--text-muted);
    }

    .reset-button {
        padding: 5px 10px;
        border: 1px solid var(--border);
        border-radius: 999px;
        color: var(--text-secondary);
        background: transparent;
        cursor: pointer;
    }

    .reset-button:hover {
        border-color: var(--accent-blue);
        color: var(--text);
        background: var(--surface-hover);
    }

    .archive-search {
        display: grid;
        grid-template-columns: auto minmax(0, 1fr);
        align-items: center;
        gap: 14px;
        margin-bottom: 18px;
        font-size: 13px;
        color: var(--text-muted);
    }

    .archive-search input {
        width: 100%;
        min-height: 42px;
        padding: 0 14px;
        border: 1px solid var(--border);
        border-radius: 8px;
        color: var(--text);
        background: var(--surface-muted);
        font: inherit;
        font-size: 15px;
    }

    .archive-search input::placeholder {
        color: var(--text-muted);
    }

    .archive-search input:focus {
        border-color: var(--accent-blue);
        outline: 2px solid color-mix(in srgb, var(--accent-blue) 22%, transparent);
        outline-offset: 1px;
    }

    .filter-lines {
        display: grid;
        gap: 12px;
    }

    .filter-lines fieldset {
        display: grid;
        grid-template-columns: 44px minmax(0, 1fr);
        gap: 12px;
        margin: 0;
        padding: 0;
        border: 0;
    }

    .filter-lines legend {
        float: left;
        padding: 5px 0;
        font-size: 13px;
        color: var(--text-muted);
    }

    .filter-options {
        display: flex;
        flex-wrap: wrap;
        gap: 6px;
    }

    .filter-options button {
        min-height: 30px;
        padding: 3px 11px;
        border: 1px solid var(--border-soft);
        border-radius: 999px;
        color: var(--text-secondary);
        background: var(--surface-muted);
        cursor: pointer;
        transition:
            border-color 160ms ease,
            color 160ms ease,
            background 160ms ease;
    }

    .filter-options button:hover {
        border-color: var(--accent-blue);
        color: var(--text);
        background: var(--surface-hover);
    }

    .filter-options button[aria-pressed="true"] {
        border-color: var(--accent-fill);
        color: var(--on-accent);
        background: var(--accent-fill);
    }

    .reset-button[hidden],
    .article-card[hidden],
    .year-group[hidden],
    .empty-results[hidden] {
        display: none;
    }

    .empty-results {
        margin: 0;
        padding: 24px;
        border: 1px dashed var(--border);
        border-radius: 8px;
        text-align: center;
        color: var(--text-muted);
        background: var(--surface);
    }

    time {
        position: absolute;
        top: 22px;
        right: 22px;
        color: var(--text-muted);
    }

    @media (max-width: 640px) {
        .title-row {
            align-items: flex-start;
            flex-wrap: wrap;
            gap: 14px;
        }

        .title-divider {
            display: none;
        }

        .article-card {
            padding: 20px 88px 20px 20px;
        }

        .archive-toggle {
            padding: 13px 16px 12px;
        }

        .archive-content {
            padding: 2px 16px 16px;
        }

        .archive-search,
        .filter-lines fieldset {
            grid-template-columns: 1fr;
            gap: 8px;
        }

        .filter-lines legend {
            float: none;
            padding: 0;
        }

        time {
            top: 20px;
            right: 20px;
        }
    }
</style>
