---
import { getCollection } from "astro:content";
import Layout from "../layouts/Layout.astro";
import { getArticleMeta } from "../lib/articles";

const articles = (await getCollection("articles", ({ data }) => {
    return data.draft !== true;
}))
    .map((article) => ({
        article,
        meta: getArticleMeta(article),
    }))
    .sort((a, b) => b.meta.writtenAt.valueOf() - a.meta.writtenAt.valueOf());

const years = [...new Set(articles.map(({ meta }) => meta.writtenAt.getFullYear()))];
---

<Layout
    title="Articles"
    description="文章和笔记列表。"
    width="860px"
>
    <header class="list-header">
        <p class="eyebrow">Articles</p>
        <div class="title-row">
            <h1>文章</h1>
            <span class="title-divider" aria-hidden="true"></span>
            <p class="intro">文章、笔记、长文和一些持续整理的想法。</p>
        </div>
    </header>

    <div class="year-list">
        {years.map((year) => (
            <section class="year-group">
                <h2 class="year-title">{year}</h2>
                <div class="article-list">
                    {articles
                        .filter(({ meta }) => meta.writtenAt.getFullYear() === year)
                        .map(({ article, meta }) => (
                            <a class="article-card" href={`/articles/${article.id}/`}>
                                <h3>{meta.title}</h3>
                                <time datetime={meta.writtenAt.toISOString()}>
                                    {article.data.writtenDate && "写于 "}
                                    {meta.writtenAt.toLocaleDateString("zh-CN", {
                                        month: "2-digit",
                                        day: "2-digit",
                                    })}
                                </time>
                                <p>{meta.summary}</p>
                                {meta.tags.length > 0 && (
                                    <ul class="article-tags" aria-label="文章标签">
                                        {meta.tags.map((tag) => (
                                            <li>{tag}</li>
                                        ))}
                                    </ul>
                                )}
                            </a>
                        ))}
                </div>
            </section>
        ))}
    </div>
</Layout>

<style>
    .list-header {
        margin-bottom: 40px;
    }

    .list-header .eyebrow {
        margin-bottom: 4px;
    }

    .title-row {
        display: flex;
        align-items: flex-end;
        gap: 20px;
    }

    .title-divider {
        width: 1px;
        height: 46px;
        flex: 0 0 auto;
        background: var(--border-strong);
    }

    h1 {
        margin: 0;
        font-size: clamp(40px, 7vw, 72px);
        line-height: 1;
    }

    .intro {
        margin: 0;
        font-size: 20px;
        line-height: 1.7;
        color: var(--text-secondary);
    }

    .year-list {
        display: grid;
        gap: 40px;
    }

    .year-title {
        margin: 0 0 16px;
        font-size: 28px;
    }

    .article-list {
        display: grid;
        gap: 16px;
    }

    .article-card {
        position: relative;
        display: block;
        padding: 22px 100px 22px 22px;
        border: 1px solid var(--border);
        border-radius: 8px;
        color: inherit;
        text-decoration: none;
        background: var(--surface);
    }

    .article-card:hover {
        border-color: var(--accent-blue);
        background: var(--surface);
    }

    .article-card h3 {
        margin: 0;
        font-size: 24px;
    }

    .article-card p {
        margin: 14px 0 0;
        color: var(--text-secondary);
        line-height: 1.7;
    }

    .article-tags {
        display: flex;
        flex-wrap: wrap;
        gap: 6px;
        margin: 12px 0 0;
        padding: 0;
        list-style: none;
    }

    .article-tags li {
        padding: 2px 8px;
        border: 1px solid color-mix(in srgb, var(--accent-blue) 38%, transparent);
        border-radius: 999px;
        font-size: 11px;
        line-height: 1.6;
        color: var(--text-muted);
        background: var(--accent-soft);
    }

    time {
        position: absolute;
        top: 22px;
        right: 22px;
        color: var(--text-muted);
    }

    @media (max-width: 640px) {
        .title-row {
            align-items: flex-start;
            flex-wrap: wrap;
            gap: 14px;
        }

        .title-divider {
            display: none;
        }

        .article-card {
            padding: 20px 88px 20px 20px;
        }

        time {
            top: 20px;
            right: 20px;
        }
    }
</style>
