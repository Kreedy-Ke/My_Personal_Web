---
import Layout from "../../layouts/Layout.astro";
---

<Layout
    title="编辑作品评价"
    description="编辑 Bangumi 作品的个人细化评分和短评。"
    width="980px"
>
    <header class="list-header">
        <p class="eyebrow">Review Editor</p>
        <div class="title-row">
            <h1>编辑作品评价</h1>
            <span class="title-divider" aria-hidden="true"></span>
            <p class="intro">为每部作品添加独立细化评分与一句短评。</p>
        </div>
    </header>

    <section class="editor-panel" aria-labelledby="editor-title">
        <div class="editor-heading">
            <div>
                <h2 id="editor-title">个人评价</h2>
                <p>细化评分使用 0–10 分，可保留一位小数；短评最多 120 字。</p>
            </div>
            <a href="/reviews/">返回作品评价</a>
        </div>

        <label class="token-field">
            <span>访问口令</span>
            <input
                type="password"
                autocomplete="current-password"
                placeholder="输入 Cloudflare 中设置的编辑口令"
                data-token
            />
        </label>

        <div class="editor-toolbar">
            <label>
                <span>类别</span>
                <select data-category></select>
            </label>
            <label>
                <span>搜索作品</span>
                <input type="search" autocomplete="off" data-search />
            </label>
            <span class="result-count" data-count></span>
        </div>
    </section>

    <p class="editor-state" data-state role="status">
        正在从 Bangumi 获取作品……
    </p>
    <div class="editor-list" data-editor-list hidden></div>

    <template data-editor-template>
        <form class="editor-card">
            <div class="editor-work">
                <img alt="" loading="lazy" />
                <div>
                    <h3></h3>
                    <p class="original-title"></p>
                    <p class="subject-id"></p>
                    <p class="bangumi-rating"></p>
                </div>
            </div>
            <div class="editor-fields">
                <label>
                    <span>细化评分</span>
                    <input type="number" min="0" max="10" step="0.1" />
                </label>
                <label class="comment-field">
                    <span>简短评价</span>
                    <input type="text" maxlength="120" />
                </label>
                <button type="submit">保存</button>
            </div>
            <p class="save-state" aria-live="polite"></p>
        </form>
    </template>
</Layout>

<script>
    type ReviewItem = {
        category: string;
        cover: string;
        id: number;
        originalTitle: string;
        rating: number;
        title: string;
    };

    type ReviewNote = {
        comment: string;
        score: number | null;
    };

    type ReviewPayload = {
        categories: {
            items: ReviewItem[];
            key: string;
            label: string;
        }[];
    };

    (() => {
        const tokenInput = document.querySelector<HTMLInputElement>("[data-token]");
        const categorySelect = document.querySelector<HTMLSelectElement>("[data-category]");
        const searchInput = document.querySelector<HTMLInputElement>("[data-search]");
        const count = document.querySelector<HTMLElement>("[data-count]");
        const state = document.querySelector<HTMLElement>("[data-state]");
        const list = document.querySelector<HTMLElement>("[data-editor-list]");
        const template = document.querySelector<HTMLTemplateElement>("[data-editor-template]");

        if (
            !tokenInput ||
            !categorySelect ||
            !searchInput ||
            !count ||
            !state ||
            !list ||
            !template
        ) {
            return;
        }

        const TOKEN_KEY = "kreedy-review-notes-token";
        let categories: ReviewPayload["categories"] = [];
        let notes: Record<string, ReviewNote> = {};
        let activeCategory = "";

        tokenInput.value = sessionStorage.getItem(TOKEN_KEY) ?? "";
        tokenInput.addEventListener("input", () => {
            sessionStorage.setItem(TOKEN_KEY, tokenInput.value);
        });

        const renderList = () => {
            const category = categories.find((item) => item.key === activeCategory);
            const query = searchInput.value.trim().toLocaleLowerCase("zh-CN");
            const items = (category?.items ?? []).filter((item) => {
                return !query || `${item.title} ${item.originalTitle}`
                    .toLocaleLowerCase("zh-CN")
                    .includes(query);
            });

            list.replaceChildren();
            count.textContent = `${items.length} 部作品`;

            for (const item of items) {
                const form = template.content.firstElementChild?.cloneNode(true) as HTMLFormElement;
                const image = form.querySelector<HTMLImageElement>("img");
                const title = form.querySelector<HTMLElement>("h3");
                const originalTitle = form.querySelector<HTMLElement>(".original-title");
                const subjectId = form.querySelector<HTMLElement>(".subject-id");
                const bangumiRating = form.querySelector<HTMLElement>(".bangumi-rating");
                const scoreInput = form.querySelector<HTMLInputElement>('input[type="number"]');
                const commentInput = form.querySelector<HTMLInputElement>('input[type="text"]');
                const saveState = form.querySelector<HTMLElement>(".save-state");
                const note = notes[String(item.id)];

                title.textContent = item.title;
                originalTitle.textContent = item.originalTitle;
                subjectId.textContent = `Bangumi ID: ${item.id}`;
                bangumiRating.textContent = `我的 Bangumi 评分：${item.rating} / 10`;
                scoreInput.value = note?.score?.toString() ?? "";
                commentInput.value = note?.comment ?? "";

                if (item.cover) {
                    image.src = item.cover;
                    image.alt = `${item.title}封面`;
                } else {
                    image.remove();
                }

                form.addEventListener("submit", async (event) => {
                    event.preventDefault();
                    saveState.textContent = "保存中……";

                    try {
                        const response = await fetch("/api/review-notes", {
                            method: "POST",
                            headers: {
                                Authorization: `Bearer ${tokenInput.value}`,
                                "Content-Type": "application/json",
                            },
                            body: JSON.stringify({
                                subjectId: item.id,
                                score: scoreInput.value,
                                comment: commentInput.value,
                            }),
                        });
                        const payload = await response.json();

                        if (!response.ok) {
                            throw new Error(payload.error ?? "保存失败。");
                        }

                        notes = payload;
                        saveState.textContent = "已保存";
                    } catch (error) {
                        saveState.textContent =
                            error instanceof Error ? error.message : "保存失败。";
                    }
                });

                list.append(form);
            }
        };

        Promise.all([
            fetch("/api/bangumi", {
                headers: { Accept: "application/json" },
            }).then(async (response) => {
                if (!response.ok) {
                    throw new Error(`HTTP ${response.status}`);
                }

                return response.json() as Promise<ReviewPayload>;
            }),
            fetch("/api/review-notes", {
                headers: { Accept: "application/json" },
            })
                .then(async (response) => {
                    return response.ok
                        ? response.json() as Promise<Record<string, ReviewNote>>
                        : {};
                })
                .catch(() => ({})),
        ])
            .then(([payload, savedNotes]) => {
                categories = payload.categories;
                notes = savedNotes;

                for (const category of categories) {
                    const option = document.createElement("option");
                    option.value = category.key;
                    option.textContent = category.label;
                    categorySelect.append(option);
                }

                activeCategory = categories[0]?.key ?? "";
                categorySelect.value = activeCategory;
                state.hidden = true;
                list.hidden = false;
                renderList();
            })
            .catch(() => {
                state.textContent = "暂时无法加载 Bangumi 作品。";
            });

        categorySelect.addEventListener("change", () => {
            activeCategory = categorySelect.value;
            renderList();
        });
        searchInput.addEventListener("input", renderList);
    })();
</script>

<style>
    .list-header {
        margin-bottom: 28px;
    }

    .list-header .eyebrow {
        margin-bottom: 4px;
    }

    .title-row {
        display: flex;
        align-items: flex-end;
        gap: 20px;
    }

    .title-divider {
        width: 1px;
        height: 46px;
        flex: 0 0 auto;
        background: var(--border-strong);
    }

    h1 {
        margin: 0;
        font-size: clamp(40px, 7vw, 68px);
        line-height: 1;
    }

    .intro {
        margin: 0;
        font-size: 18px;
        line-height: 1.7;
        color: var(--text-secondary);
    }

    .editor-panel {
        margin-bottom: 20px;
        padding: 22px;
        border: 1px solid var(--border);
        border-radius: 10px;
        background: var(--surface);
    }

    .editor-heading {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        gap: 24px;
        margin-bottom: 18px;
    }

    .editor-heading h2 {
        margin: 0 0 6px;
        font-size: 24px;
    }

    .editor-heading p {
        margin: 0;
        color: var(--text-secondary);
    }

    .editor-heading a {
        flex: 0 0 auto;
        color: var(--accent-blue);
    }

    .token-field,
    .editor-toolbar label {
        display: grid;
        gap: 6px;
        font-size: 13px;
        color: var(--text-secondary);
    }

    .token-field input,
    .editor-toolbar input,
    .editor-toolbar select,
    .editor-fields input {
        min-height: 38px;
        padding: 6px 10px;
        border: 1px solid var(--border);
        border-radius: 7px;
        color: var(--text);
        background: var(--surface-muted);
        font: inherit;
    }

    .editor-toolbar {
        display: grid;
        grid-template-columns: 180px minmax(0, 1fr) auto;
        gap: 12px;
        align-items: end;
        margin-top: 14px;
    }

    .result-count {
        padding-bottom: 10px;
        font-size: 12px;
        color: var(--text-muted);
    }

    .editor-state {
        margin: 0;
        padding: 28px;
        border: 1px dashed var(--border);
        border-radius: 8px;
        text-align: center;
        color: var(--text-muted);
        background: var(--surface);
    }

    .editor-list {
        display: grid;
        gap: 10px;
    }

    .editor-list[hidden],
    .editor-state[hidden] {
        display: none;
    }

    .editor-card {
        display: grid;
        grid-template-columns: minmax(240px, 1fr) minmax(420px, 1.6fr);
        gap: 18px;
        padding: 14px;
        border: 1px solid var(--border);
        border-radius: 8px;
        background: var(--surface);
    }

    .editor-work {
        display: grid;
        grid-template-columns: 58px minmax(0, 1fr);
        gap: 12px;
        min-width: 0;
        align-items: start;
    }

    .editor-work img {
        width: 58px;
        aspect-ratio: 3 / 4;
        border-radius: 4px;
        object-fit: cover;
        background: var(--cover-bg);
    }

    .editor-work h3 {
        margin: 0;
        font-size: 17px;
        line-height: 1.4;
    }

    .editor-work p {
        margin: 3px 0 0;
        font-size: 11px;
        color: var(--text-muted);
    }

    .editor-work .bangumi-rating {
        display: inline-block;
        margin-top: 7px;
        padding: 2px 7px;
        border-radius: 999px;
        color: var(--accent-fill);
        background: var(--accent-soft);
    }

    .editor-fields {
        display: grid;
        grid-template-columns: 100px minmax(0, 1fr) auto;
        gap: 10px;
        align-items: end;
    }

    .editor-fields label {
        display: grid;
        gap: 5px;
        min-width: 0;
        font-size: 12px;
        color: var(--text-muted);
    }

    .editor-fields button {
        min-height: 38px;
        padding: 6px 16px;
        border: 0;
        border-radius: 7px;
        color: var(--on-accent);
        background: var(--accent-fill);
        cursor: pointer;
    }

    .save-state {
        grid-column: 2;
        min-height: 17px;
        margin: 0;
        font-size: 12px;
        color: var(--text-muted);
    }

    @media (max-width: 820px) {
        .editor-card,
        .editor-toolbar,
        .editor-fields {
            grid-template-columns: 1fr;
        }

        .save-state {
            grid-column: 1;
        }
    }

    @media (max-width: 640px) {
        .title-row {
            flex-wrap: wrap;
            align-items: flex-start;
            gap: 14px;
        }

        .title-divider {
            display: none;
        }
    }
</style>
