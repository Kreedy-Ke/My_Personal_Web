---
import { getCollection } from "astro:content";
import { SITE_NAME } from "../config";
import Layout from "../layouts/Layout.astro";

type RecentUpdate = {
    title: string;
    href: string;
    type: string;
    date: Date;
    summary: string;
};

const sections = [
    {
        title: "Articles",
        href: "/articles/",
        description: "文章、笔记、长文和一些持续整理的想法。",
    },
    {
        title: "Gallery",
        href: "/gallery/",
        description: "图片集、摄影、截图和视觉记录。",
    },
    {
        title: "Reviews",
        href: "/reviews/",
        description: "对书、电影、动画、游戏、音乐和他人作品的评价。",
    },
];

const [articles, galleries, reviews] = await Promise.all([
    getCollection("articles", ({ data }) => data.draft !== true),
    getCollection("galleries", ({ data }) => data.draft !== true),
    getCollection("reviews", ({ data }) => data.draft !== true),
]);

const stats = [
    {
        label: "Articles",
        value: articles.length,
        href: "/articles/",
    },
    {
        label: "Galleries",
        value: galleries.length,
        href: "/gallery/",
    },
    {
        label: "Reviews",
        value: reviews.length,
        href: "/reviews/",
    },
];

const recentUpdates: RecentUpdate[] = [
    ...articles.map((article) => ({
        title: article.data.title,
        href: `/articles/${article.id}/`,
        type: "文章",
        date: article.data.date,
        summary: article.data.summary,
    })),
    ...galleries.map((gallery) => ({
        title: gallery.data.title,
        href: `/gallery/${gallery.id}/`,
        type: "图片集",
        date: gallery.data.date,
        summary: gallery.data.summary,
    })),
    ...reviews.map((review) => ({
        title: review.data.workTitle,
        href: `/reviews/${review.id}/`,
        type: "评价",
        date: review.data.date,
        summary: review.data.summary,
    })),
]
    .sort((a, b) => b.date.valueOf() - a.date.valueOf())
    .slice(0, 5);
---

<Layout
    description="一个用于存放文章、图片集、作品评价和个人档案的个人站。"
    width="1280px"
>
    <div class="home-grid">
        <header class="status-panel panel" aria-labelledby="home-title">
            <div class="status-top">
                <div>
                    <p class="eyebrow">
                        <span>Personal Site</span>
                        <span class="eyebrow-line" aria-hidden="true"></span>
                        <span>Console</span>
                    </p>
                    <h1 id="home-title">{SITE_NAME}</h1>
                    <p class="intro">
                        这里会存放我的文章、图片集、作品评价，以及一些长期整理的个人档案。
                    </p>
                </div>
            </div>

            <nav class="stat-grid" aria-label="站点内容统计">
                {stats.map((stat) => (
                    <a class="stat" href={stat.href}>
                        <span>{stat.label}</span>
                        <strong>{String(stat.value).padStart(2, "0")}</strong>
                    </a>
                ))}
            </nav>
        </header>

        <aside class="console-panel panel" aria-labelledby="console-title">
            <div class="console-bar">
                <span class="window-dots" aria-hidden="true">
                    <i></i><i></i><i></i>
                </span>
                <span>personal-site:~</span>
                <span>v1.0</span>
            </div>
            <div class="console-body">
                <p class="console-kicker">SYSTEM INDEX</p>
                <h2 id="console-title">内容控制台</h2>
                <div class="console-lines">
                    <p><span>STATUS</span> ONLINE</p>
                    <p><span>SECTIONS</span> 03</p>
                    <p><span>ENTRIES</span> {String(articles.length + galleries.length + reviews.length).padStart(2, "0")}</p>
                    <p>
                        <span>LAST_SIGNAL</span>
                        {recentUpdates[0]
                            ? recentUpdates[0].date.toLocaleDateString("zh-CN", {
                                  year: "numeric",
                                  month: "2-digit",
                                  day: "2-digit",
                              })
                            : "WAITING"}
                    </p>
                </div>
                <p class="console-command">
                    <span aria-hidden="true">$</span> open #profile
                    <i aria-hidden="true"></i>
                </p>
            </div>
        </aside>
    </div>

    <section class="profile-section panel" id="profile" aria-labelledby="profile-title">
        <header class="profile-header">
            <div class="panel-heading">
                <span class="title-index" aria-hidden="true">01</span>
                <h2 id="profile-title">简介</h2>
            </div>
        </header>

        <div class="profile-columns">
            <section class="profile-block" aria-labelledby="about-me-title">
                <h3 id="about-me-title">关于我</h3>
                <p class="profile-greeting">你好，很高兴在这里见到你。</p>
                <p>
                    叫我柯苗苗或者苗吧。如果你偏好英文名，也可以叫我 Kreedy_Ke。
                </p>
            </section>

            <section class="profile-block" aria-labelledby="about-site-title">
                <h3 id="about-site-title">关于这个网站</h3>
                <p>
                    这里是我长期维护的个人空间，用来保存文章、图片、作品评价，以及那些值得慢慢整理的想法。
                </p>
                <p>
                    网站会随着时间继续补充和调整，希望你能在这里找到感兴趣的内容。
                </p>
            </section>
        </div>
    </section>

    <section class="dashboard" aria-label="站点概览">
        <section class="dashboard-panel panel updates-panel" aria-labelledby="recent-updates-title">
            <div class="panel-heading">
                <span class="title-index" aria-hidden="true">02</span>
                <h2 id="recent-updates-title">最近更新</h2>
            </div>

            {recentUpdates.length > 0 ? (
                <div class="update-list">
                    {recentUpdates.map((update) => (
                        <a class="update-item" href={update.href}>
                            <div class="update-meta">
                                <span class="update-type">{update.type}</span>
                                <time datetime={update.date.toISOString()}>
                                    {update.date.toLocaleDateString("zh-CN", {
                                        month: "2-digit",
                                        day: "2-digit",
                                    })}
                                </time>
                            </div>
                            <div class="update-copy">
                                <h3>{update.title}</h3>
                                <p>{update.summary}</p>
                            </div>
                        </a>
                    ))}
                </div>
            ) : (
                <p class="empty-updates">暂时还没有发布内容。</p>
            )}
        </section>

        <nav class="dashboard-panel panel gates-panel" aria-labelledby="gates-title">
            <div class="panel-heading">
                <span class="title-index" aria-hidden="true">03</span>
                <h2 id="gates-title">站点入口</h2>
            </div>
            <div class="gate-list">
                {sections.map((section) => (
                    <a class="gate-link" href={section.href}>
                        <span class="gate-copy">
                            <strong>{section.title}</strong>
                            <small>{section.description}</small>
                        </span>
                    </a>
                ))}
            </div>
        </nav>
    </section>

    <footer class="welcome-footer">
        <p>欢迎随便逛逛，希望这里有你感兴趣的内容。</p>
    </footer>
</Layout>

<style>
    .home-grid {
        display: grid;
        grid-template-columns: minmax(0, 1.12fr) minmax(300px, 0.88fr);
        gap: 20px;
        align-items: stretch;
    }

    .panel {
        position: relative;
        overflow: hidden;
        border: 1px solid #d8d0c2;
        border-radius: 12px;
        background: #fffaf1;
        box-shadow: 0 14px 36px rgb(42 40 71 / 7%);
    }

    .status-panel {
        display: flex;
        min-height: 360px;
        flex-direction: column;
        justify-content: space-between;
        padding: 34px;
        background: #fffaf1;
    }

    .status-panel::before,
    .profile-section::before,
    .dashboard-panel::before {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 3px;
        background: var(--accent-gradient);
        content: "";
    }

    .eyebrow {
        display: flex;
        align-items: center;
        gap: 10px;
        margin: 0 0 12px;
        font-size: 14px;
        letter-spacing: 0;
        text-transform: uppercase;
        color: #6b7280;
    }

    .eyebrow-line {
        width: 36px;
        height: 1px;
        background: var(--accent-blue);
    }

    h1 {
        margin: 0;
        font-size: clamp(50px, 5.6vw, 88px);
        line-height: 0.92;
        letter-spacing: -0.055em;
    }

    .status-top {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        gap: 24px;
    }

    .intro {
        max-width: 560px;
        margin: 24px 0 0;
        font-size: 18px;
        line-height: 1.7;
        color: #4b5563;
    }

    .stat-grid {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 1px;
        margin: 34px -34px -34px;
        border-top: 1px solid #ded6c8;
        background: #ded6c8;
    }

    .stat {
        display: grid;
        gap: 10px;
        padding: 18px 22px 20px;
        color: inherit;
        text-decoration: none;
        background: rgb(255 250 241 / 94%);
        transition: background 160ms ease;
    }

    .stat:hover {
        background: #f1f6fc;
    }

    .stat span {
        font-size: 12px;
        text-transform: uppercase;
        color: #6b7280;
    }

    .stat strong {
        font-size: 30px;
        font-weight: 600;
        line-height: 1;
        color: #1f2933;
    }

    .console-panel {
        display: flex;
        min-height: 360px;
        flex-direction: column;
        border-color: rgb(70 131 209 / 60%);
        color: #f8f4ed;
        background: #25364a;
        box-shadow: 0 20px 44px rgb(42 54 87 / 20%);
    }

    .console-bar {
        display: grid;
        grid-template-columns: 1fr auto 1fr;
        gap: 12px;
        align-items: center;
        padding: 12px 16px;
        border-bottom: 1px solid rgb(255 255 255 / 11%);
        font-family: "SFMono-Regular", Consolas, "Liberation Mono", monospace;
        font-size: 10px;
        letter-spacing: 0.04em;
        color: #b8c8d9;
    }

    .console-bar > span:last-child {
        text-align: right;
    }

    .window-dots {
        display: flex;
        gap: 5px;
    }

    .window-dots i {
        width: 7px;
        height: 7px;
        border: 0;
        border-radius: 50%;
    }

    .window-dots i:nth-child(1) {
        background: var(--accent-blue);
    }

    .window-dots i:nth-child(2) {
        background: var(--accent-blue);
    }

    .window-dots i:nth-child(3) {
        background: var(--accent-blue);
    }

    .console-body {
        display: flex;
        flex: 1;
        flex-direction: column;
        padding: 26px;
        background-image: linear-gradient(rgb(255 255 255 / 3%) 1px, transparent 1px);
        background-size: 100% 26px;
    }

    .console-kicker {
        margin: 0 0 12px;
        font-family: "SFMono-Regular", Consolas, "Liberation Mono", monospace;
        font-size: 11px;
        letter-spacing: 0.12em;
        color: #b8c8d9;
    }

    .console-panel h2 {
        margin: 0;
        font-size: 30px;
        line-height: 1.3;
        letter-spacing: -0.03em;
    }

    .console-lines {
        display: grid;
        gap: 7px;
        margin: 24px 0 20px;
        font-family: "SFMono-Regular", Consolas, "Liberation Mono", monospace;
        font-size: 12px;
        color: #e3ebf3;
    }

    .console-lines p {
        display: flex;
        gap: 10px;
        margin: 0;
    }

    .console-lines span {
        width: 92px;
        flex: 0 0 auto;
        color: #aab7d4;
    }

    .console-command {
        display: flex;
        align-items: center;
        gap: 8px;
        margin: auto 0 0;
        font-family: "SFMono-Regular", Consolas, "Liberation Mono", monospace;
        font-size: 13px;
        color: #e1e9f6;
    }

    .console-command i {
        width: 7px;
        height: 15px;
        background: var(--accent-blue);
        animation: blink 1.1s steps(1) infinite;
    }

    .dashboard {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 16px;
        margin-top: 16px;
    }

    .dashboard-panel {
        min-width: 0;
        padding: 24px;
    }

    .panel-heading {
        display: flex;
        align-items: center;
        gap: 12px;
        margin-bottom: 22px;
    }

    .panel-heading h2 {
        margin: 0;
        font-size: 22px;
        line-height: 1.3;
    }

    .title-index {
        display: grid;
        width: 34px;
        height: 34px;
        flex: 0 0 auto;
        place-items: center;
        border: 2px solid #f6f2ea;
        border-radius: 50%;
        font-family: "SFMono-Regular", Consolas, "Liberation Mono", monospace;
        font-size: 11px;
        font-weight: 700;
        line-height: 1;
        color: #fffaf1;
        background: var(--accent-blue);
        box-shadow:
            0 0 0 2px #73a6c8,
            0 0 0 5px rgb(127 181 223 / 12%);
    }

    .profile-section {
        margin-top: 16px;
        padding: 24px;
        scroll-margin-top: 32px;
        background: #fffaf1;
    }

    .profile-header {
        display: flex;
        align-items: flex-end;
        justify-content: space-between;
        gap: 24px;
        padding-bottom: 16px;
        border-bottom: 1px solid #e1d9cc;
    }

    .profile-header .panel-heading {
        margin-bottom: 0;
    }

    .profile-header h2 {
        margin: 0;
        font-size: 22px;
        line-height: 1.3;
        letter-spacing: 0;
    }

    .profile-columns {
        display: grid;
        grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr);
        padding-top: 20px;
    }

    .profile-block {
        min-width: 0;
        padding-right: 34px;
    }

    .profile-block + .profile-block {
        padding-right: 0;
        padding-left: 36px;
        border-left: 1px solid #e1d9cc;
    }

    .profile-block h3 {
        margin: 0 0 12px;
        font-size: 22px;
        line-height: 1.3;
    }

    .profile-block p {
        margin: 0;
        font-size: 15px;
        line-height: 1.65;
        color: #4b5563;
    }

    .profile-block .profile-greeting {
        margin-bottom: 8px;
        border-left: 0;
        font-size: 18px;
        font-weight: 600;
        line-height: 1.5;
        color: #1f2933;
    }

    .update-list {
        display: grid;
        gap: 8px;
    }

    .update-item {
        display: grid;
        gap: 8px 12px;
        padding: 13px 13px 14px;
        border: 1px solid #e1d9cc;
        border-radius: 8px;
        color: inherit;
        text-decoration: none;
        background: #f8f3e9;
        transition:
            border-color 160ms ease,
            background 160ms ease,
            transform 160ms ease;
    }

    .update-item:hover {
        border-color: var(--accent-blue);
        background: #fffaf1;
        transform: translateY(-1px);
    }

    .update-meta {
        display: flex;
        grid-column: 1 / -1;
        gap: 8px;
        align-items: center;
    }

    .update-type {
        padding: 2px 7px;
        border: 1px solid rgb(70 131 209 / 28%);
        border-radius: 999px;
        font-size: 10px;
        color: #1f2933;
        background: #f1f6fc;
    }

    .update-meta time {
        font-size: 11px;
        color: #6b7280;
    }

    .update-copy h3 {
        margin: 0 0 4px;
        font-size: 16px;
        line-height: 1.4;
    }

    .update-item:hover .update-copy h3 {
        text-decoration: underline;
        text-underline-offset: 3px;
    }

    .update-copy p,
    .empty-updates {
        margin: 0;
        display: -webkit-box;
        overflow: hidden;
        font-size: 13px;
        line-height: 1.6;
        color: #4b5563;
        -webkit-box-orient: vertical;
        -webkit-line-clamp: 2;
    }

    .empty-updates {
        display: block;
        padding: 18px;
        border: 1px dashed #d8d0c2;
        border-radius: 8px;
    }

    .gate-list {
        display: grid;
        gap: 8px;
    }

    .gate-link {
        display: grid;
        padding: 13px;
        border: 1px solid #e1d9cc;
        border-radius: 8px;
        color: inherit;
        text-decoration: none;
        background: #f8f3e9;
        transition:
            border-color 160ms ease,
            background 160ms ease;
    }

    .gate-link:hover {
        border-color: var(--accent-blue);
        background: #fffaf1;
    }

    .gate-copy {
        display: grid;
        gap: 4px;
    }

    .gate-copy strong {
        font-size: 15px;
    }

    .gate-copy small {
        font-size: 12px;
        line-height: 1.55;
        color: #6b7280;
    }

    .welcome-footer {
        display: flex;
        gap: 14px;
        align-items: center;
        margin-top: 16px;
        padding: 20px 22px;
        border: 1px dashed #d8d0c2;
        border-radius: 10px;
        color: #4b5563;
    }

    .welcome-footer p {
        margin: 0;
        line-height: 1.7;
    }

    @keyframes blink {
        50% {
            opacity: 0;
        }
    }

    @media (prefers-reduced-motion: reduce) {
        .console-command i {
            animation: none;
        }
    }

    @media (max-width: 1250px) {
        .home-grid,
        .dashboard {
            grid-template-columns: 1fr;
        }
    }

    @media (max-width: 900px) {
        .profile-columns {
            grid-template-columns: 1fr;
            gap: 20px;
        }

        .profile-block {
            padding-right: 0;
        }

        .profile-block + .profile-block {
            padding-top: 20px;
            padding-left: 0;
            border-top: 1px solid #e1d9cc;
            border-left: 0;
        }
    }

    @media (max-width: 720px) {
        .status-panel,
        .dashboard-panel {
            padding: 24px;
        }

        .stat-grid {
            margin: 28px -24px -24px;
        }

        .status-top {
            display: block;
        }

        .profile-section {
            padding: 20px;
        }

        .update-item {
            gap: 8px;
        }
    }
</style>
