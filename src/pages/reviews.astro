---
import Layout from "../layouts/Layout.astro";
---

<Layout
    title="Reviews"
    description="动画、漫画和轻小说的 Bangumi 评分记录。"
    width="980px"
>
    <header class="list-header">
        <p class="eyebrow">Reviews</p>
        <div class="title-row">
            <h1>作品评价</h1>
            <span class="title-divider" aria-hidden="true"></span>
            <p class="intro">动画、漫画与轻小说的个人评分记录。</p>
        </div>
    </header>

    <p class="source-note">
        数据来自
        <a href="https://bgm.tv/user/kreedy_ke" data-profile-link>Bangumi</a>，
        每 6 小时自动更新。仅显示已评分的作品；完结状态优先读取 Bangumi
        标签，缺失时按收藏进度推断。
    </p>

    <p class="review-state" data-review-state role="status">
        正在从 Bangumi 获取收藏……
    </p>

    <section class="review-browser" data-review-browser hidden>
        <nav
            class="folder-nav category-tabs"
            data-category-tabs
            aria-label="作品类型"
        ></nav>

        <div class="folder-body">
            <details class="filter-index">
                <summary class="filter-summary">
                    <span class="filter-title">标签索引</span>
                    <span class="filter-summary-state">
                        <span data-filter-summary>日本 · 看过</span>
                        <span class="filter-chevron" aria-hidden="true"></span>
                    </span>
                </summary>

                <div class="folder-filters">
                    <div class="folder-row">
                        <span class="folder-label">地区</span>
                        <div class="folder-options" data-region-tabs role="group" aria-label="地区筛选">
                            <button class="folder-tab" type="button" data-region="all" aria-pressed="false">
                                全部地区
                            </button>
                            <button class="folder-tab" type="button" data-region="japan" aria-pressed="true">
                                日本
                            </button>
                            <button class="folder-tab" type="button" data-region="non-japan" aria-pressed="false">
                                非日本
                            </button>
                        </div>
                    </div>

                    <div class="folder-row">
                        <span class="folder-label">状态</span>
                        <div class="folder-options" data-completion-tabs role="group" aria-label="连载状态筛选">
                            <button class="folder-tab" type="button" data-completion="all" aria-pressed="true">
                                全部
                            </button>
                            <button class="folder-tab" type="button" data-completion="completed" aria-pressed="false">
                                完结
                            </button>
                            <button class="folder-tab" type="button" data-completion="ongoing" aria-pressed="false">
                                未完结
                            </button>
                        </div>
                    </div>

                    <div class="folder-row">
                        <span class="folder-label">观看状态</span>
                        <div class="folder-options" data-status-tabs role="group" aria-label="观看状态筛选">
                            <button class="folder-tab" type="button" data-status="all" aria-pressed="false">
                                全部
                            </button>
                            <button class="folder-tab" type="button" data-status="watching" aria-pressed="false">
                                在看
                            </button>
                            <button class="folder-tab" type="button" data-status="watched" aria-pressed="true">
                                看过
                            </button>
                            <button class="folder-tab" type="button" data-status="wish" aria-pressed="false">
                                想看
                            </button>
                            <button class="folder-tab" type="button" data-status="dropped" aria-pressed="false">
                                抛弃
                            </button>
                            <button class="folder-tab" type="button" data-status="onhold" aria-pressed="false">
                                搁置
                            </button>
                        </div>
                    </div>
                </div>
            </details>

            <section class="review-results">
                <header class="group-header">
                    <h2 data-active-title></h2>
                    <span class="group-count" data-active-count></span>
                </header>
                <div class="review-grid" data-review-grid></div>
                <p class="empty-result" data-empty-result hidden>
                    当前筛选条件下没有作品。
                </p>
                <nav
                    class="review-pagination"
                    data-review-pagination
                    aria-label="作品分页"
                    hidden
                >
                    <button type="button" data-page-prev>上一页</button>
                    <div class="page-numbers" data-page-numbers></div>
                    <button type="button" data-page-next>下一页</button>
                </nav>
            </section>
        </div>
    </section>

    <template data-card-template>
        <a class="review-card" target="_blank" rel="noreferrer">
            <div class="cover-wrap">
                <img alt="" loading="lazy" />
                <span class="cover-placeholder">暂无封面</span>
            </div>
            <div class="review-body">
                <div class="review-heading">
                    <h3></h3>
                    <p class="original-title"></p>
                </div>
                <div class="score-line">
                    <span class="release-year" hidden></span>
                    <p class="scores">
                        <span class="my-score"></span>
                        <span class="score-separator">/</span>
                        <span class="bangumi-score"></span>
                        <span class="score-note">（我的评分/Bangumi 均分）</span>
                    </p>
                </div>
            </div>
        </a>
    </template>

    <p class="sync-time" data-sync-time hidden></p>
</Layout>

<script>
    type ReviewItem = {
        category: string;
        completion: "completed" | "ongoing" | "unknown";
        cover: string;
        date: string;
        originalTitle: string;
        rating: number;
        region: "japan" | "non-japan";
        status: string;
        statusKey: string;
        subjectScore: number | null;
        title: string;
        url: string;
    };

    type Category = {
        items: ReviewItem[];
        key: string;
        label: string;
    };

    type ReviewPayload = {
        categories: Category[];
        profileUrl: string;
        syncedAt: string;
    };

    (() => {
        const state = document.querySelector<HTMLElement>("[data-review-state]");
        const browser = document.querySelector<HTMLElement>("[data-review-browser]");
        const categoryTabs = document.querySelector<HTMLElement>("[data-category-tabs]");
        const regionTabs = document.querySelector<HTMLElement>("[data-region-tabs]");
        const completionTabs = document.querySelector<HTMLElement>("[data-completion-tabs]");
        const statusTabs = document.querySelector<HTMLElement>("[data-status-tabs]");
        const filterSummary = document.querySelector<HTMLElement>("[data-filter-summary]");
        const grid = document.querySelector<HTMLElement>("[data-review-grid]");
        const activeTitle = document.querySelector<HTMLElement>("[data-active-title]");
        const activeCount = document.querySelector<HTMLElement>("[data-active-count]");
        const emptyResult = document.querySelector<HTMLElement>("[data-empty-result]");
        const pagination = document.querySelector<HTMLElement>("[data-review-pagination]");
        const pageNumbers = document.querySelector<HTMLElement>("[data-page-numbers]");
        const pagePrev = document.querySelector<HTMLButtonElement>("[data-page-prev]");
        const pageNext = document.querySelector<HTMLButtonElement>("[data-page-next]");
        const cardTemplate = document.querySelector<HTMLTemplateElement>("[data-card-template]");
        const profileLink = document.querySelector<HTMLAnchorElement>("[data-profile-link]");
        const syncTime = document.querySelector<HTMLElement>("[data-sync-time]");

        if (
            !state ||
            !browser ||
            !categoryTabs ||
            !regionTabs ||
            !completionTabs ||
            !statusTabs ||
            !filterSummary ||
            !grid ||
            !activeTitle ||
            !activeCount ||
            !emptyResult ||
            !pagination ||
            !pageNumbers ||
            !pagePrev ||
            !pageNext ||
            !cardTemplate ||
            !syncTime
        ) {
            return;
        }

        const PAGE_SIZE = 20;
        let categories: Category[] = [];
        let activeCategory = "";
        let region = "japan";
        let completion = "all";
        let status = "watched";
        let currentPage = 1;

        const updateFilterSummary = () => {
            const regionLabels: Record<string, string> = {
                all: "全部地区",
                japan: "日本",
                "non-japan": "非日本",
            };
            const completionLabels: Record<string, string> = {
                all: "",
                completed: "完结",
                ongoing: "未完结",
            };
            const statusLabels: Record<string, string> = {
                all: "",
                watching: "在看",
                watched: "看过",
                wish: "想看",
                dropped: "抛弃",
                onhold: "搁置",
            };
            const labels = [
                regionLabels[region],
                completionLabels[completion],
                statusLabels[status],
            ].filter(Boolean);

            filterSummary.textContent = labels.join(" · ");
        };

        const setButtonPressed = (container: HTMLElement, selected: HTMLButtonElement) => {
            container.querySelectorAll<HTMLButtonElement>("button").forEach((button) => {
                button.setAttribute("aria-pressed", String(button === selected));
                button.classList.toggle("is-active", button === selected);
            });
        };

        const createCard = (item: ReviewItem) => {
            const card = cardTemplate.content.firstElementChild?.cloneNode(true) as HTMLAnchorElement;
            const image = card.querySelector<HTMLImageElement>("img");
            const placeholder = card.querySelector<HTMLElement>(".cover-placeholder");
            const title = card.querySelector<HTMLElement>("h3");
            const originalTitle = card.querySelector<HTMLElement>(".original-title");
            const releaseYear = card.querySelector<HTMLElement>(".release-year");
            const myScore = card.querySelector<HTMLElement>(".my-score");
            const bangumiScore = card.querySelector<HTMLElement>(".bangumi-score");

            card.href = item.url;
            title.textContent = item.title;
            myScore.textContent = item.rating.toFixed(1);
            bangumiScore.textContent = item.subjectScore === null
                ? "--"
                : item.subjectScore.toFixed(1);

            if (item.originalTitle) {
                originalTitle.textContent = item.originalTitle;
            } else {
                originalTitle.remove();
            }

            if (item.date) {
                releaseYear.textContent = item.date.slice(0, 4);
                releaseYear.hidden = false;
            }

            if (item.cover) {
                image.src = item.cover;
                image.alt = `${item.title}封面`;
                placeholder.hidden = true;
            } else {
                image.remove();
            }

            return card;
        };

        const renderResults = () => {
            const category = categories.find((item) => item.key === activeCategory);

            if (!category) {
                return;
            }

            const items = category.items.filter((item) => {
                const matchesRegion = region === "all" || item.region === region;
                const matchesCompletion =
                    completion === "all" || item.completion === completion;
                const matchesStatus = status === "all" || item.statusKey === status;

                return matchesRegion && matchesCompletion && matchesStatus;
            });
            const totalPages = Math.max(1, Math.ceil(items.length / PAGE_SIZE));
            currentPage = Math.min(currentPage, totalPages);
            const pageItems = items.slice(
                (currentPage - 1) * PAGE_SIZE,
                currentPage * PAGE_SIZE,
            );

            grid.replaceChildren();
            activeTitle.textContent = category.label;
            activeCount.textContent = `${items.length} 部 · 第 ${currentPage} / ${totalPages} 页`;
            emptyResult.hidden = items.length > 0;
            pagination.hidden = items.length === 0 || totalPages === 1;

            for (const item of pageItems) {
                grid.append(createCard(item));
            }

            pageNumbers.replaceChildren();

            for (let page = 1; page <= totalPages; page += 1) {
                const button = document.createElement("button");
                button.type = "button";
                button.className = "page-number";
                button.textContent = String(page);
                button.setAttribute("aria-label", `第 ${page} 页`);
                button.setAttribute(
                    "aria-current",
                    page === currentPage ? "page" : "false",
                );
                button.addEventListener("click", () => {
                    currentPage = page;
                    renderResults();
                });
                pageNumbers.append(button);
            }

            pagePrev.disabled = currentPage === 1;
            pageNext.disabled = currentPage === totalPages;
        };

        const renderCategoryTabs = () => {
            categoryTabs.replaceChildren();

            for (const [index, category] of categories.entries()) {
                const button = document.createElement("button");
                button.className = "folder-main-tab";
                button.type = "button";
                button.textContent = `${category.label} ${category.items.length}`;
                button.setAttribute("aria-pressed", String(index === 0));
                button.classList.toggle("is-active", index === 0);
                button.addEventListener("click", () => {
                    activeCategory = category.key;
                    currentPage = 1;
                    setButtonPressed(categoryTabs, button);
                    renderResults();
                });
                categoryTabs.append(button);
            }

            activeCategory = categories[0]?.key ?? "";
        };

        const bindFilterGroup = (
            container: HTMLElement,
            attribute: "region" | "completion" | "status",
            apply: (value: string) => void,
        ) => {
            container.querySelectorAll<HTMLButtonElement>(`[data-${attribute}]`).forEach((button) => {
                button.addEventListener("click", () => {
                    apply(button.dataset[attribute] ?? "all");
                    currentPage = 1;
                    setButtonPressed(container, button);
                    updateFilterSummary();
                    renderResults();
                });
            });
        };

        bindFilterGroup(regionTabs, "region", (value) => {
            region = value;
        });
        bindFilterGroup(completionTabs, "completion", (value) => {
            completion = value;
        });
        bindFilterGroup(statusTabs, "status", (value) => {
            status = value;
        });
        updateFilterSummary();

        pagePrev.addEventListener("click", () => {
            currentPage = Math.max(1, currentPage - 1);
            renderResults();
        });

        pageNext.addEventListener("click", () => {
            currentPage += 1;
            renderResults();
        });

        fetch("/api/bangumi", {
            headers: { Accept: "application/json" },
        })
            .then(async (response) => {
                if (!response.ok) {
                    throw new Error(`HTTP ${response.status}`);
                }

                return response.json() as Promise<ReviewPayload>;
            })
            .then((payload) => {
                categories = payload.categories;

                if (profileLink) {
                    profileLink.href = payload.profileUrl;
                }

                if (payload.categories.every((category) => category.items.length === 0)) {
                    state.textContent = "Bangumi 中暂无已评分的动画、漫画或轻小说。";
                    return;
                }

                renderCategoryTabs();
                renderResults();
                state.hidden = true;
                browser.hidden = false;
                syncTime.textContent = `最近同步：${new Date(payload.syncedAt).toLocaleString("zh-CN")}`;
                syncTime.hidden = false;
            })
            .catch(() => {
                state.textContent = "暂时无法从 Bangumi 获取收藏，请稍后再试。";
                state.classList.add("is-error");
            });
    })();
</script>

<style>
    .list-header {
        margin-bottom: 24px;
    }

    .list-header .eyebrow {
        margin-bottom: 4px;
    }

    .title-row {
        display: flex;
        align-items: flex-end;
        gap: 20px;
    }

    .title-divider {
        width: 1px;
        height: 46px;
        flex: 0 0 auto;
        background: var(--border-strong);
    }

    h1 {
        margin: 0;
        font-size: clamp(40px, 7vw, 72px);
        line-height: 1;
    }

    .intro {
        margin: 0;
        font-size: 20px;
        line-height: 1.7;
        color: var(--text-secondary);
    }

    .source-note,
    .sync-time {
        margin: 0 0 24px;
        font-size: 13px;
        color: var(--text-muted);
    }

    .source-note a {
        color: var(--accent-blue);
    }

    .review-state {
        margin: 0;
        padding: 28px;
        border: 1px dashed var(--border);
        border-radius: 8px;
        text-align: center;
        color: var(--text-muted);
        background: var(--surface);
    }

    .review-state.is-error {
        color: var(--text-secondary);
    }

    .review-browser {
        --review-accent: #56c096;
        --review-ink: #173326;
        --review-strong: #20583b;
        --review-soft: #dff9e8;

        position: relative;
        margin-top: 24px;
        overflow: hidden;
        padding: 0;
        border: 1px solid var(--review-accent);
        border-radius: 10px;
        color: var(--review-ink);
        background: var(--review-accent);
        box-shadow: 0 18px 42px rgb(86 192 150 / 30%);
    }

    .review-browser[hidden],
    .review-card[hidden],
    .empty-result[hidden],
    .folder-tab[hidden] {
        display: none;
    }

    .folder-options {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 6px;
    }

    .category-tabs {
        position: static;
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 2px;
        margin: 0;
        padding: 6px 6px 0;
        background: var(--review-accent);
    }

    :global(.folder-main-tab) {
        width: 100%;
        min-width: 0;
        min-height: 41px;
        padding: 8px 16px 7px;
        border: 0;
        border-radius: 9px 9px 0 0;
        color: var(--review-strong);
        background: color-mix(in srgb, var(--review-accent) 32%, white);
        box-shadow: inset 0 -8px 10px -10px rgb(0 0 0 / 20%);
        cursor: pointer;
    }

    :global(.folder-main-tab:hover) {
        color: var(--review-ink);
        background: var(--review-soft);
    }

    :global(.folder-main-tab[aria-pressed="true"]),
    :global(.folder-main-tab.is-active) {
        z-index: 1;
        color: var(--review-ink) !important;
        background: var(--review-accent) !important;
        font-weight: 650;
        box-shadow: none;
    }

    .folder-body {
        padding: 24px;
    }

    .folder-tab {
        min-height: 30px;
        padding: 3px 11px;
        border: 1px solid rgb(23 51 38 / 24%);
        border-radius: 999px;
        color: var(--review-strong);
        background: rgb(255 255 255 / 30%);
        cursor: pointer;
        transition:
            border-color 160ms ease,
            color 160ms ease,
            background 160ms ease;
    }

    .folder-tab:hover {
        border-color: var(--review-strong);
        color: var(--review-ink);
        background: rgb(255 255 255 / 48%);
    }

    .folder-tab[aria-pressed="true"] {
        border-color: var(--review-strong);
        color: white;
        background: var(--review-strong);
    }

    .filter-index {
        overflow: hidden;
        margin-bottom: 28px;
        border: 1px solid rgb(23 51 38 / 18%);
        border-radius: 8px;
        background: rgb(255 255 255 / 14%);
    }

    .filter-summary {
        display: flex;
        min-height: 40px;
        align-items: center;
        justify-content: space-between;
        gap: 16px;
        padding: 9px 13px;
        list-style: none;
        cursor: pointer;
    }

    .filter-summary::-webkit-details-marker {
        display: none;
    }

    .filter-title {
        font-size: 14px;
        font-weight: 650;
    }

    .filter-summary-state {
        display: inline-flex;
        align-items: center;
        gap: 10px;
        font-size: 12px;
        color: rgb(23 51 38 / 70%);
    }

    .filter-chevron {
        width: 0;
        height: 0;
        border-top: 6px solid currentColor;
        border-right: 5px solid transparent;
        border-left: 5px solid transparent;
        transition: transform 160ms ease;
    }

    .filter-index[open] .filter-chevron {
        transform: rotate(180deg);
    }

    .folder-filters {
        display: grid;
        gap: 13px;
        margin: 0;
        padding: 13px;
        border-top: 1px solid rgb(23 51 38 / 18%);
    }

    .folder-row {
        display: grid;
        grid-template-columns: 38px minmax(0, 1fr);
        gap: 10px;
        align-items: start;
    }

    .folder-label {
        padding-top: 5px;
        font-size: 12px;
        color: rgb(23 51 38 / 72%);
    }

    .review-results {
        min-width: 0;
    }

    .group-header {
        display: flex;
        align-items: baseline;
        gap: 12px;
        margin-bottom: 14px;
        padding-bottom: 10px;
        border-bottom: 1px solid rgb(23 51 38 / 24%);
    }

    .group-header h2 {
        margin: 0;
        font-size: 26px;
    }

    .group-count {
        font-size: 13px;
        color: rgb(23 51 38 / 70%);
    }

    .review-grid {
        display: grid;
        grid-template-columns: 1fr;
        gap: 10px;
    }

    .review-card {
        display: grid;
        grid-template-columns: 82px minmax(0, 1fr);
        gap: 16px;
        min-width: 0;
        padding: 12px;
        border: 1px solid rgb(23 51 38 / 20%);
        border-radius: 8px;
        color: var(--review-ink);
        text-decoration: none;
        background: rgb(255 255 255 / 36%);
        transition:
            border-color 160ms ease,
            background 160ms ease;
    }

    .review-card:hover {
        border-color: var(--review-strong);
        background: rgb(255 255 255 / 54%);
    }

    .cover-wrap {
        position: relative;
        aspect-ratio: 3 / 4;
        overflow: hidden;
        border-radius: 5px;
        background: rgb(23 51 38 / 16%);
    }

    .cover-wrap img {
        display: block;
        width: 100%;
        height: 100%;
        object-fit: cover;
    }

    .cover-placeholder {
        position: absolute;
        inset: 0;
        display: grid;
        place-items: center;
        padding: 8px;
        text-align: center;
        font-size: 11px;
        color: rgb(23 51 38 / 68%);
    }

    .cover-placeholder[hidden] {
        display: none;
    }

    .review-body {
        min-width: 0;
    }

    .review-heading {
        display: flex;
        flex-wrap: wrap;
        align-items: baseline;
        gap: 4px 12px;
    }

    .review-heading h3 {
        margin: 0;
        overflow-wrap: anywhere;
        font-size: 20px;
        line-height: 1.4;
    }

    .original-title {
        margin: 0;
        overflow-wrap: anywhere;
        font-size: 13px;
        line-height: 1.4;
        color: rgb(23 51 38 / 68%);
    }

    .score-line {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 8px;
        margin-top: 12px;
    }

    .release-year {
        padding: 1px 6px;
        border: 1px solid rgb(23 51 38 / 38%);
        border-radius: 2px;
        font-size: 11px;
        line-height: 1.5;
        color: var(--review-strong);
    }

    .release-year[hidden] {
        display: none;
    }

    .scores {
        display: flex;
        flex-wrap: wrap;
        align-items: baseline;
        gap: 2px;
        margin: 0;
        font-size: 13px;
        font-weight: 650;
        line-height: 1.5;
    }

    .my-score {
        color: #0c3b27;
    }

    .score-separator {
        color: rgb(23 51 38 / 56%);
    }

    .bangumi-score {
        color: #7a4a00;
    }

    .score-note {
        margin-left: 3px;
        font-size: 11px;
        font-weight: 400;
        color: rgb(23 51 38 / 62%);
    }

    .empty-result {
        margin: 0;
        padding: 28px;
        border: 1px dashed rgb(23 51 38 / 30%);
        border-radius: 8px;
        text-align: center;
        color: rgb(23 51 38 / 76%);
        background: rgb(255 255 255 / 24%);
    }

    .review-pagination {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 10px;
        margin-top: 24px;
    }

    .review-pagination[hidden] {
        display: none;
    }

    .review-pagination button {
        min-height: 32px;
        padding: 4px 10px;
        border: 1px solid rgb(23 51 38 / 28%);
        border-radius: 6px;
        color: var(--review-ink);
        background: rgb(255 255 255 / 32%);
        cursor: pointer;
    }

