---
import { getCollection } from "astro:content";
import Layout from "../layouts/Layout.astro";

const reviews = (await getCollection("reviews", ({ data }) => {
    return data.draft !== true;
})).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const years = [...new Set(reviews.map((review) => review.data.date.getFullYear()))];

const categoryLabels = {
    book: "书籍",
    movie: "电影",
    anime: "动画",
    game: "游戏",
    music: "音乐",
    art: "艺术",
    other: "其他",
};

const statusLabels = {
    planned: "想看",
    watching: "在看",
    reading: "在读",
    playing: "在玩",
    finished: "已完成",
    paused: "暂停",
    dropped: "放弃",
};
---

<Layout
    title="Reviews"
    description="作品评价列表。"
    width="920px"
>
    <header class="list-header">
        <p class="eyebrow">Reviews</p>
        <div class="title-row">
            <h1>作品评价</h1>
            <span class="title-divider" aria-hidden="true"></span>
            <p class="intro">书、电影、动画、游戏、音乐和其他作品的记录与评价。</p>
        </div>
    </header>

    {reviews.length > 0 ? (
        <div class="year-list">
            {years.map((year) => (
                <section class="year-group">
                    <h2 class="year-title">{year}</h2>
                    <div class="review-list">
                        {reviews
                            .filter((review) => review.data.date.getFullYear() === year)
                            .map((review) => (
                                <a class="review-card" href={`/reviews/${review.id}/`}>
                                    {review.data.cover ? (
                                        <img
                                            src={review.data.cover}
                                            alt=""
                                            loading="lazy"
                                        />
                                    ) : (
                                        <div class="cover-placeholder">
                                            {categoryLabels[review.data.category]}
                                        </div>
                                    )}

                                    <div class="review-body">
                                        <div class="review-title">
                                            <h3>{review.data.workTitle}</h3>
                                            {review.data.originalTitle && (
                                                <p>{review.data.originalTitle}</p>
                                            )}
                                        </div>

                                        <div class="review-meta">
                                            <span>{categoryLabels[review.data.category]}</span>
                                            <span>{statusLabels[review.data.status]}</span>
                                            {review.data.year && <span>{review.data.year}</span>}
                                            {review.data.rating !== undefined && (
                                                <span>{review.data.rating}/10</span>
                                            )}
                                        </div>

                                        <p class="summary">{review.data.summary}</p>
                                    </div>
                                </a>
                            ))}
                    </div>
                </section>
            ))}
        </div>
    ) : (
        <p class="empty-reviews">还没有作品评价。</p>
    )}
</Layout>

<style>
    .list-header {
        margin-bottom: 40px;
    }

    .list-header .eyebrow {
        margin-bottom: 4px;
    }

    .title-row {
        display: flex;
        align-items: flex-end;
        gap: 20px;
    }

    .title-divider {
        width: 1px;
        height: 46px;
        flex: 0 0 auto;
        background: var(--border-strong);
    }

    h1 {
        margin: 0;
        font-size: clamp(40px, 7vw, 72px);
        line-height: 1;
    }

    .intro {
        margin: 0;
        font-size: 20px;
        line-height: 1.7;
        color: var(--text-secondary);
    }

    .year-list {
        display: grid;
        gap: 40px;
    }

    .year-title {
        margin: 0 0 16px;
        font-size: 28px;
    }

    .review-list {
        display: grid;
        gap: 16px;
    }

    .empty-reviews {
        margin: 0;
        padding: 28px;
        border: 1px dashed var(--border);
        border-radius: 8px;
        text-align: center;
        color: var(--text-muted);
        background: var(--surface);
    }

    .review-card {
        display: grid;
        grid-template-columns: 112px 1fr;
        gap: 20px;
        padding: 18px;
        border: 1px solid var(--border);
        border-radius: 8px;
        color: inherit;
        text-decoration: none;
        background: var(--surface);
    }

    .review-card:hover {
        border-color: var(--accent-blue);
        background: var(--surface);
    }

    .review-card img,
    .cover-placeholder {
        width: 112px;
        height: 156px;
        border-radius: 6px;
        object-fit: cover;
        background: var(--cover-bg);
    }

    .cover-placeholder {
        display: grid;
        place-items: center;
        padding: 12px;
        text-align: center;
        color: var(--text-muted);
    }

    .review-title h3 {
        margin: 0 0 6px;
        font-size: 24px;
    }

    .review-title p {
        margin: 0;
        color: var(--text-muted);
    }

    .review-meta {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
        margin: 16px 0;
    }

    .review-meta span {
        padding: 4px 8px;
        border: 1px solid var(--border);
        border-radius: 999px;
        font-size: 14px;
        color: var(--text-secondary);
    }

    .summary {
        margin: 0;
        line-height: 1.7;
        color: var(--text-secondary);
    }

    @media (max-width: 640px) {
        .title-row {
            align-items: flex-start;
            flex-wrap: wrap;
            gap: 14px;
        }

        .title-divider {
            display: none;
        }

        .review-card {
            grid-template-columns: 80px 1fr;
            gap: 14px;
        }

        .review-card img,
        .cover-placeholder {
            width: 80px;
            height: 112px;
        }
    }
</style>
